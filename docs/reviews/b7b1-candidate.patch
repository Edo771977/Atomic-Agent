From 93c5cd6e723c6fec2559bd636b290ac905a6483c Mon Sep 17 00:00:00 2001
From: Nadia Rodionova <273119990+sosidudku1@users.noreply.github.com>
Date: Wed, 18 Nov 2026 14:57:04 +0300
Subject: [PATCH 2/2] Crawl: a sitemap over 2 MB is read in part, not skipped;
 note fetch failures

Sitemaps were fetched with --max-filesize 2 MB, so a plain sitemap
with a Content-Length over that made curl exit 63 and the whole
sitemap was dropped silently. --max-filesize is now a 50 MB disk guard
(the sitemap protocol's own limit); the read back still keeps the
first 2 MB and marks the rest truncated, so the first entries are
crawled. A sitemap that cannot be fetched now leaves a note in the
crawl result.

(cherry picked from commit 520893c4562dca64c878fdc3eab133590c7cc769)
---
 src/tools/os/web/web-crawl-run.ts  |  3 ++-
 src/tools/os/web/web-crawl.test.ts |  5 ++++-
 src/tools/os/web/web-fetch.ts      | 14 ++++++++++----
 3 files changed, 16 insertions(+), 6 deletions(-)

diff --git a/src/tools/os/web/web-crawl-run.ts b/src/tools/os/web/web-crawl-run.ts
index 83828e9bd..0b970ea35 100644
--- a/src/tools/os/web/web-crawl-run.ts
+++ b/src/tools/os/web/web-crawl-run.ts
@@ -332,7 +332,8 @@ async function loadSitemap(
     try {
       // As bytes: `.xml.gz` and gzip-typed sitemaps are unzipped here (ATO-970).
       res = await input.fetchPage(sitemapUrl.toString(), { binary: true });
-    } catch {
+    } catch (err) {
+      notes.push(`Sitemap ${sitemapUrl.toString()} could not be fetched: ${err instanceof Error ? err.message : String(err)}.`);
       continue;
     }
     if (res.status < 200 || res.status >= 300) continue;
diff --git a/src/tools/os/web/web-crawl.test.ts b/src/tools/os/web/web-crawl.test.ts
index 13cb6dc0a..e4246f0d5 100644
--- a/src/tools/os/web/web-crawl.test.ts
+++ b/src/tools/os/web/web-crawl.test.ts
@@ -321,7 +321,10 @@ describe("os.web.crawl", () => {
       // curl must not unpack it: the size cap is ours.
       expect(sitemapReq!.args).not.toContain("--compressed");
       expect(sitemapReq!.args).toContain("Accept-Encoding: gzip");
-      expect(sitemapReq!.args).toContain("--max-filesize");
+      // A 50 MB disk guard, not the 2 MB read cap: a big plain sitemap
+      // still yields its first entries instead of failing whole.
+      const guard = sitemapReq!.args[sitemapReq!.args.indexOf("--max-filesize") + 1];
+      expect(guard).toBe(String(50 * 1024 * 1024));
       // Pages are still fetched as text.
       expect(site.binaryRequests.map((r) => r.url)).toEqual([`${O}/sitemap.xml.gz`]);
     });
diff --git a/src/tools/os/web/web-fetch.ts b/src/tools/os/web/web-fetch.ts
index 7be1825aa..2b0f4b034 100644
--- a/src/tools/os/web/web-fetch.ts
+++ b/src/tools/os/web/web-fetch.ts
@@ -56,6 +56,8 @@ import {
 } from "./web-fetch-ladder.js";
 
 const MAX_RESPONSE_BYTES = 2_000_000;
+/** How much a `binaryBody` request may write to disk before curl stops. */
+const MAX_BINARY_DOWNLOAD_BYTES = 50 * 1024 * 1024;
 const MAX_REDIRECTS = 3;
 const DEFAULT_MAX_CHARS = 50_000;
 const MAX_CHARS_CAP = 50_000;
@@ -732,9 +734,9 @@ async function curlOnce(
 /**
  * `curlOnce` for a `binaryBody` request: the body goes to a file in a fresh
  * private temp dir (`-o`), stdout carries only the `-w` meta line, and the
- * file is read back as bytes and removed. `--max-filesize` stops curl past
- * the usual 2 MB; a body without a Content-Length that runs past it is cut
- * when read and marked truncated.
+ * file is read back as bytes and removed. Only the first 2 MB are read
+ * back (the rest is marked truncated); `--max-filesize` is a 50 MB disk
+ * guard on top.
  */
 async function curlOnceBinary(
   url: URL,
@@ -830,8 +832,12 @@ function buildCurlArgs(
       : [
           "-H",
           "Accept-Encoding: gzip",
+          // A disk guard, not the cap: the read below keeps the first
+          // MAX_RESPONSE_BYTES and marks the rest truncated, so a big
+          // uncompressed sitemap still yields its first entries. 50 MB is
+          // the sitemap protocol's own size limit.
           "--max-filesize",
-          String(MAX_RESPONSE_BYTES),
+          String(MAX_BINARY_DOWNLOAD_BYTES),
           "-o",
           binaryBodyPath,
         ]),
