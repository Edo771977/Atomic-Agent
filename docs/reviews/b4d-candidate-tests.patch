diff --git a/src/integrations/b4d-candidate.test.ts b/src/integrations/b4d-candidate.test.ts
new file mode 100644
--- /dev/null
+++ b/src/integrations/b4d-candidate.test.ts
@@ -0,0 +1,14 @@
+import { expect, it } from "vitest";
+import { findMonidServer, monidServerUrl } from "./monid-integration.js";
+
+it("control: recognizes the catalog origin under a different local name", () => {
+  expect(findMonidServer([{ name: "official", transport: { kind: "http", url: monidServerUrl() } }])?.name).toBe("official");
+});
+it.each([
+  "https://foreign.example/mcp",
+  "https://user:password@foreign.example/mcp",
+  "https://foreign.example./mcp",
+  "http://localhost./mcp",
+])("does not choose a foreign origin just because its name is monid: %s", url => {
+  expect(findMonidServer([{ name: "monid", transport: { kind: "http", url } }])).toBeUndefined();
+});
