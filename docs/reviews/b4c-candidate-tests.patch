+++ b/src/prompt/b4c-candidate.test.ts
@@ -0,0 +1,18 @@
+import { expect, it } from "vitest";
+import { buildStablePrefix } from "./stable-prefix.js";
+
+it("keeps stable prefix bytes identical after an account default changes", () => {
+  const input = {
+    toolDescriptors: [{ name: "mcp.composio.COMPOSIO_SEARCH_TOOLS", summary: "Search", argsSchema: "{}" }],
+    capabilities: { platform: "linux", arch: "x64", browserChannel: "none", workingDir: "/fixture", hasClipboard: false, hasWmctrl: false, hasNotifications: false },
+    skillCatalog: [],
+  };
+  const accounts = [
+    { toolkit: "gmail", alias: "work", isDefault: true },
+    { toolkit: "gmail", alias: "home", isDefault: false },
+  ];
+  const before = buildStablePrefix({ ...input, composioAccounts: accounts });
+  const after = buildStablePrefix({ ...input, composioAccounts: accounts.map(a => ({ ...a, isDefault: !a.isDefault })) });
+  expect(before).toContain("Composio");
+  expect(Buffer.from(after).equals(Buffer.from(before))).toBe(true);
+});
